# ORBIT API configuration. Copy to .env and adjust. Every value has a safe development default.

NODE_ENV=development
PORT=4000

# Database: "sqlite" (zero setup, default) or "postgres"
DB_TYPE=sqlite
DB_PATH=./data/orbit.sqlite
# DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit

# Secrets. REQUIRED (min 32 chars) when NODE_ENV=production.
# JWT_SECRET=
# PIN_SECRET=
# WEBHOOK_SECRET=

# Business rules (from the ORBIT business proposal, section 6 and 11)
COMMISSION_BPS=800          # 8.00% marketplace commission on item subtotal
ORBIT_DELIVERY_FEE=700      # what the customer pays for an ORBIT courier delivery (NGN)
COURIER_PAYOUT=400          # what the rider earns; the remainder (NGN 300) is ORBIT's contribution
PENDING_PAYMENT_TTL_MIN=15  # unpaid orders are cancelled and stock released after this

# Payments. "mock" simulates a gateway (no real money). Not allowed in production unless ALLOW_MOCK_PAYMENTS=true.
PAYMENT_PROVIDER=mock
# ALLOW_MOCK_PAYMENTS=false

# Comma-separated browser origins allowed by CORS (development allows all)
# CORS_ORIGINS=https://app.example.com

# Load demo shops, users and riders when the database is empty (never in production)
SEED_ON_BOOT=true
