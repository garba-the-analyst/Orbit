# ORBIT API configuration. Copy to .env and adjust. Every value has a safe development default.

NODE_ENV=development
PORT=4000

# Database: "sqlite" (zero setup, default) or "postgres"
DB_TYPE=sqlite
DB_PATH=./data/orbit.sqlite
# DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit

# Secrets. REQUIRED (min 32 chars) when NODE_ENV=production.
# JWT_SECRET=
# PIN_SECRET=
# WEBHOOK_SECRET=

# Business rules (from the ORBIT business proposal, section 6 and 11)
COMMISSION_BPS=800          # 8.00% marketplace commission on item subtotal
ORBIT_DELIVERY_FEE=700      # what the customer pays for an ORBIT courier delivery (NGN)
COURIER_PAYOUT=400          # what the rider earns; the remainder (NGN 300) is ORBIT's contribution
PENDING_PAYMENT_TTL_MIN=15  # unpaid orders are cancelled and stock released after this

# Payments. "mock" simulates a gateway (no real money). Not allowed in production unless ALLOW_MOCK_PAYMENTS=true.
PAYMENT_PROVIDER=mock
# ALLOW_MOCK_PAYMENTS=false

# Paystack (live gateway). Set PAYMENT_PROVIDER=paystack and provide test/live keys.
# Keys: sk_test_..., pk_test_... from the Paystack dashboard. Keep these out of git.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=

# Comma-separated browser origins allowed by CORS (development allows all)
# CORS_ORIGINS=https://app.example.com

# Load demo shops, users and riders when the database is empty (never in production)
SEED_ON_BOOT=true

# --- v2: accounts, markets, maps, storage, mail ---------------------------------------------------
# The first superadmin, created once on first boot (never by promoting an existing account). Put real values only in
# your local, git-ignored .env or your host's dashboard. Change the password after first sign-in.
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# SUPERADMIN_NAME=Super Admin

# Countries: NG, GH, KE, ZA are configured.
ENABLED_MARKETS=NG
DEFAULT_MARKET=NG

# Free OpenStreetMap services by default. Swap for a paid or self-hosted provider at scale.
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
# GEO_CONTACT=you@example.com   # identifies your app to Nominatim, as its usage policy requires

# Pictures (public) and documents (private). local = ./uploads (development). s3 = any S3-compatible bucket (hosting).
STORAGE_DRIVER=local
# UPLOAD_DIR=./uploads
# S3_ENDPOINT=  S3_REGION=  S3_PUBLIC_BUCKET=  S3_PRIVATE_BUCKET=  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=  S3_PUBLIC_BASE=

# Password-reset email. Without it, reset links are logged instead of sent.
# SMTP_URL=smtps://user:pass@smtp.example.com
# MAIL_FROM="ORBIT <no-reply@example.com>"
# APP_URL=https://your-web-app.example.com
# PUBLIC_BASE_URL=https://your-api.example.com

# Hosted PostgreSQL (Neon, Supabase, Render external URL) needs TLS.
# DB_SSL=true
